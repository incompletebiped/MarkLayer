# Content pages are served straight from the asset layer, so they never run
# the Worker's HSTS middleware (apps/worker/src/index.ts). Reapply it here.
#
# Scoped deliberately: `/*` carries HSTS only. The SPA shell at `/` must not
# inherit a one-hour max-age, or an app deploy would take an hour to reach
# browsers that already have it cached.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Self-hosted webfonts the app's stylesheet still loads. Content-addressed by
# name, so they can be cached for a year. The CORS header is for crossorigin
# preloads, which are cached apart from plain requests.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/support
  Cache-Control: public, max-age=3600

/privacy
  Cache-Control: public, max-age=3600

/mcp
  Cache-Control: public, max-age=3600

/mcp.md
  Cache-Control: public, max-age=86400
  Content-Type: text/markdown; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml
