---
import { COLOPHON, FOOTER_COLUMNS } from '../../lib/footer';
import { COMPANY_NAME, COMPANY_URL, CONTACT_EMAIL } from '../../lib/site';

// Prerendered content for `/`. apps/worker/web/main.tsx clears #app on boot and
// renders <Landing/> over it, so this is what crawlers and first paint see.
// Keep its claims in step with apps/worker/web/Landing.tsx.
---

<p style="margin: 0 0 12px; color: #5a6680">Redline by {COMPANY_NAME}</p>
<h1>Mark it in red. We'll knock it out.</h1>
<p>
  Circle a photo, point at a button, flag a typo, or tell us something just feels off. Every mark lands on our list, and
  you watch each one get checked off.
</p>

<h2>How it works</h2>
<ol>
  <li>
    <strong>Open your website in Redline.</strong> Your site shows up with a red pen on top, right in your browser.
    Nothing to install.
  </li>
  <li>
    <strong>Mark what you want changed.</strong> Circle it, point an arrow at it, or click to pin a note. Say it however you
    would say it to us in person.
  </li>
  <li>
    <strong>Watch it get done.</strong> Each mark goes on our to-do list. As we finish one, it gets checked off, and you can
    see that on the same page.
  </li>
</ol>

<h2>Questions?</h2>
<p>
  Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> or visit <a href={COMPANY_URL}>simplelocalweb.com</a>.
  There is more on the <a href="/support">help page</a>.
</p>

<footer>
  <nav>
    {
      FOOTER_COLUMNS.flatMap((col) => col.links)
        .filter((l) => l.href !== '/')
        .map((l) => <a href={l.href}>{l.label}</a>)
    }
  </nav>
  <p><small>{COLOPHON}</small></p>
</footer>
