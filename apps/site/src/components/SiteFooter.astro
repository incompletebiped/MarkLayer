---
import { COLOPHON, FOOTER_COLUMNS } from '../lib/footer';
import { UPSTREAM_REPO_URL } from '../lib/site';
import { STATUS_LABEL } from '../lib/status';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

{/* Shares its links with the app shell's footer in apps/worker/web/Landing.tsx via lib/footer.ts. */}
<footer class="ml-floor">
  <div class="ml-floor-inner">
    <div class="grid max-w-xl grid-cols-2 gap-x-8 gap-y-9 text-label">
      {
        FOOTER_COLUMNS.map((col) => (
          <div>
            <p class="ml-floor-heading">{col.heading}</p>
            <ul class="m-0 list-none space-y-0.5 p-0">
              {col.links.map((l) => (
                <li class="m-0 p-0">
                  <a
                    class="ml-floor-link"
                    href={l.href}
                    target={l.external ? '_blank' : undefined}
                    rel={l.external ? 'noopener noreferrer' : undefined}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-rule pt-6">
      <p class="ml-floor-fine mt-0 flex items-start gap-2">
        <Logo size={16} class="mt-px shrink-0" />
        <span>
          &copy; {year} {COLOPHON}{' '}
          <a href={UPSTREAM_REPO_URL} target="_blank" rel="noopener noreferrer">Source on GitHub</a>.
        </span>
      </p>
      {/* Rendered at `ok`, which the page attests by being served; the script only ever downgrades it. */}
      <p class="ml-live m-0 max-w-none" data-ml-status="ok" role="status">
        <span class="ml-live-dot" aria-hidden="true"></span>
        <span data-ml-status-label>{STATUS_LABEL.ok}</span>
      </p>
    </div>
  </div>
</footer>

<script>
  import { probeStatus, STATUS_LABEL } from '../lib/status';

  const line = document.querySelector('[data-ml-status]');
  const label = line?.querySelector('[data-ml-status-label]');
  if (line instanceof HTMLElement && label) {
    probeStatus().then((status) => {
      if (status === 'ok') return;
      line.dataset.mlStatus = status;
      label.textContent = STATUS_LABEL[status];
    });
  }
</script>
