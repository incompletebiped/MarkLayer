---
/**
 * The Redline mark: a navy rounded square with a white square-cap check. Drawn
 * on a 52 box (rx 8), so it scales cleanly to any `size`.
 */
interface Props {
  /** Rendered box in px. */
  size?: number;
  class?: string;
}

const { size = 34, class: className } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 52 52" aria-hidden="true" class={className}>
  <rect width="52" height="52" rx="8" fill="#0E3A75"></rect>
  <g transform="translate(11 11) scale(1.25)">
    <path d="M4 12.5l5 5L20 6" fill="none" stroke="#FFFFFF" stroke-width="3.2" stroke-linecap="square"></path>
  </g>
</svg>
