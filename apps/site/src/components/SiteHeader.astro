---
import { SECTIONS } from '../lib/site';
import Logo from './Logo.astro';

interface Props {
  /** This page's path. Marks its own link as current. */
  path: string;
}

const { path } = Astro.props;
---

<header class="ml-nav">
  <div class="mx-auto flex min-h-16 w-full max-w-page flex-wrap items-center justify-between gap-x-6 gap-y-2 px-(--gutter) py-3">
    <a class="ml-wordmark" href="/" aria-label="Redline home">
      <Logo size={30} class="shrink-0" />
      <span class="ml-wordmark-text">Redline</span>
    </a>
    <nav class="-me-3 flex flex-wrap items-center" aria-label="Site">
      {
        SECTIONS.map((s) => (
          <a class="ml-nav-link" href={s.href} aria-current={s.href === path ? 'page' : undefined}>
            {s.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
