---
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import dates from '../data/page-dates.json';
import { breadcrumbSchema } from '../lib/schema';
import { COMPANY_NAME, COMPANY_URL, CONTACT_EMAIL, ORIGIN, pageOgImage } from '../lib/site';

// One string: the card is keyed by a hash of the heading.
const h1 = 'Privacy';
const title = 'Privacy · Redline by Simple Local Web';
const description =
  'What Redline keeps, where it lives and when it is deleted. Hosted on Cloudflare, no analytics, and marks are cleared out 90 days after anyone last opened them.';
const updated = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(
  new Date(`${dates.privacy.modified}T00:00:00Z`),
);
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonical={`${ORIGIN}/privacy`}
      ogType="website"
      ogImage={pageOgImage({ heading: h1, path: '/privacy' })}
      schema={[breadcrumbSchema([{ name: 'Redline', path: '/' }, { name: 'Privacy' }])]}
    />
  </head>
  <body>
    <SiteHeader path="/privacy" />
    <main class="ml-shell">
      <h1>{h1}</h1>
      <p class="ml-meta mt-0 mb-8">Last updated {updated}</p>
      <p class="ml-lede">
        Redline is run by <a href={COMPANY_URL}>{COMPANY_NAME}</a>. This page says, in plain words, what it keeps when you
        use it and what happens to that.
      </p>

      <h2>Where it runs</h2>
      <p>
        Redline is hosted on Cloudflare. Your marks, comments and the pages they sit on are stored in Cloudflare's
        database and storage services, and the live connection that shows everyone the same marks runs there too. To
        show your website inside Redline, our server loads the page for you.
      </p>

      <h2>What gets saved</h2>
      <ul>
        <li>
          <strong>Your marks and comments.</strong> Drawings, pins, notes and replies you leave on a page, along with the
          address of the page you marked up.
        </li>
        <li>
          <strong>Files you upload.</strong> A PDF or image you add is kept in Cloudflare R2 storage so the people on the
          link can see it.
        </li>
        <li>
          <strong>A display name.</strong> The name and colour shown beside your marks are kept in your own browser, and
          sent along only while you are working on a shared page.
        </li>
        <li>
          <strong>Your email, if you sign in.</strong> Signing in is done with a link we email you. No password is stored.
          We keep your email address so we can show you the pages you own.
        </li>
      </ul>

      <h2>When it is deleted</h2>
      <p>
        Marks, comments and uploaded files are deleted automatically 90 days after the page was last opened. Opening or
        commenting on a page resets that clock. A page can also be set to expire sooner, and it is deleted when it does.
      </p>

      <h2>What we do not do</h2>
      <ul>
        <li>No analytics or tracking scripts run on Redline.</li>
        <li>No advertising, and we do not sell or share what you leave here.</li>
      </ul>

      <h2>Questions</h2>
      <p>
        Want something removed sooner, or have a question about any of this? Email
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </main>
    <SiteFooter />
  </body>
</html>
