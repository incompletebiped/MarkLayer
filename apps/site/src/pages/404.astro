---
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { CONTACT_EMAIL, ORIGIN } from '../lib/site';
---

<html lang="en">
  <head>
    <BaseHead
      title="Page not found · Redline"
      description="That page does not exist. Head back to Redline or get in touch with Simple Local Web."
      canonical={`${ORIGIN}/404`}
      ogType="website"
      noindex
    />
  </head>
  <body>
    <SiteHeader path="/404" />
    <main class="ml-shell">
      <h1>Nothing here.</h1>
      <p class="ml-lede">That link may be old, or it may have a typo in it.</p>
      <p>
        <a class="ml-cta" href="/">Back to Redline</a>
      </p>
      <p class="ml-meta mt-6">
        Looking for a page we sent you? Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> and we will send it
        again.
      </p>
    </main>
    <SiteFooter />
  </body>
</html>
