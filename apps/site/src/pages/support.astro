---
import BaseHead from '../components/BaseHead.astro';
import Faq from '../components/Faq.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { breadcrumbSchema, faqSchema, type QA } from '../lib/schema';
import { COMPANY_NAME, COMPANY_URL, CONTACT_EMAIL, ORIGIN, pageOgImage } from '../lib/site';

// One string: the card is keyed by a hash of the heading.
const h1 = 'Need a hand?';
const title = 'Help · Redline by Simple Local Web';
const description =
  'How to mark up your website with Redline, and how to reach Simple Local Web when something is not working.';

const qa: QA[] = [
  {
    q: 'Do I need to install anything?',
    a: 'No. Redline runs in your web browser. Open the link and start marking.',
  },
  {
    q: 'How do I point out a change?',
    a: 'Pick the pen to circle something, the arrow to point at it, or click to pin a note. Write it the way you would say it to us. "Make this photo bigger" is plenty.',
  },
  {
    q: 'How do I know when something is done?',
    a: 'Each mark gets checked off on the page as we finish it. Open the same link any time to see where things stand.',
  },
  {
    q: 'Can someone else on my team leave marks too?',
    a: 'Yes. Send them the same link. Everyone on it sees the same marks, live.',
  },
  {
    q: 'My website does not show up, or looks broken.',
    a: `Some websites block being shown inside other tools. Take a screenshot and upload it instead, or email ${CONTACT_EMAIL} and we will sort it out.`,
  },
  {
    q: 'How long do my marks stay around?',
    a: 'They are deleted 90 days after the page was last opened. Opening or commenting on the page resets that clock.',
  },
];
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonical={`${ORIGIN}/support`}
      ogImage={pageOgImage({ heading: h1, path: '/support' })}
      ogType="website"
      schema={[faqSchema(qa), breadcrumbSchema([{ name: 'Redline', path: '/' }, { name: 'Help' }])]}
    />
  </head>
  <body>
    <SiteHeader path="/support" />
    <main class="ml-shell">
      <h1>{h1}</h1>
      <p class="ml-lede">
        Redline is how you tell {COMPANY_NAME} what to change on your website. If something is confusing or not working,
        write to us. A real person reads every email.
      </p>
      <p>
        <a class="ml-cta" href={`mailto:${CONTACT_EMAIL}`}>Email {CONTACT_EMAIL}</a>
      </p>

      <h2>The short version</h2>
      <ol>
        <li>Open your website in Redline.</li>
        <li>Circle, point at or pin a note on anything you want changed.</li>
        <li>We get your list, do the work and check each item off.</li>
      </ol>

      <Faq qa={qa} />

      <p class="ml-meta mt-12">
        More about us at <a href={COMPANY_URL}>simplelocalweb.com</a>. See also <a href="/privacy">what Redline keeps and
        when it is deleted</a>.
      </p>
    </main>
    <SiteFooter />
  </body>
</html>
